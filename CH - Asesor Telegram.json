    {
      "parameters": {
        "jsCode": "const raw = $json.output || '';\n// Telegram interpreta '_' y '*' sueltos como marcado (cursiva/negrita) y\n// rompe si no encuentra el cierre -- por ejemplo 'Cliente_ID' abre una\n// cursiva que nunca cierra. Los sacamos para que llegue como texto plano\n// sin importar que caracteres use el modelo.\nconst texto = raw\n  .replace(/_/g, ' ')\n  .replace(/[*`\\[\\]]/g, '');\nreturn [{ json: { textoSeguro: texto } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
