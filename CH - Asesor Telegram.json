    {
      "parameters": {
        "jsCode": "const total = $input.all().length;\n// La consigna pide 'se activa al superar los 5 mensajes'. Para controlar el\n// costo de llamadas al modelo, lo resolvemos con una cadencia periodica de\n// 5 en 5 (5, 10, 15...) en vez de disparar en cada mensaje despues del\n// quinto -- el guardado sigue siendo idempotente (upsert), asi que cada\n// disparo sobrescribe el resumen anterior con la version mas reciente.\nconst UMBRAL_MENSAJES = 5;\nconst toca_resumir = total > 0 && total % UMBRAL_MENSAJES === 0;\nreturn [{ json: { toca_resumir, total_mensajes: total } }];"
      },
