    {
      "parameters": {
        "jsCode": "const items = $input.all();\n// Airtable Search devuelve los valores anidados bajo 'fields', no en el\n// nivel superior del item -- por eso se lee i.json.fields.X, no i.json.X.\nconst texto = items.map(i => {\n  const f = i.json.fields || {};\n  return `${f.Rol || '??'}: ${f.Mensaje || ''}`;\n}).join('\\n');\nreturn [{ json: { conversacion: texto || '(sin mensajes)' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        240
      ],
      "id": "61166a26-2a47-447b-af36-c22c2b2c70b6",
      "name": "Armar texto de conversación"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "builtInTools": {},
        "options": {}
