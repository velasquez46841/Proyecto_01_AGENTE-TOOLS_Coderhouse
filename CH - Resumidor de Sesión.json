        432
      ],
      "id": "ab5e0624-6faf-4c2b-9ccd-d49b1f43d903",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "KEu1v8a7r7oKfrrh",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Mismo patron tolerante que el resto del proyecto: acepta texto u objeto\n// ya estructurado, y desenvuelve una posible clave extra 'output'.\nlet raw = item.output;\nif (raw && typeof raw === 'object') {\n  raw = raw.output && typeof raw.output === 'object' ? raw.output : raw;\n} else {\n  raw = (raw || '').toString().replace(/```json|```/g, '').trim();\n  try {\n    const parsed = JSON.parse(raw);\n    raw = (parsed.output && typeof parsed.output === 'object') ? parsed.output : parsed;\n  } catch (e) {\n    raw = null;\n  }\n}\n\nconst data = raw;\nconst asuntoPrincipal = (data && data.asunto_principal) || 'Sin asunto identificado';\nconst puntosClave = (data && Array.isArray(data.puntos_clave)) ? data.puntos_clave : [];\nconst accionRequerida = (data && data.accion_requerida) || null;\n\nreturn [{\n  json: {\n    resumenConsolidado: asuntoPrincipal,\n    datosClave: puntosClave.join('\\n'),\n    estadoDelCaso: accionRequerida || 'Sin acciones pendientes',\n    chatId: String($('Trigger: recibir tarea').first().json.chatId)\n  }\n}];"
      },
