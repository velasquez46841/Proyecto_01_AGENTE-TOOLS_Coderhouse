    {
      "parameters": {
        "jsCode": "const err = $input.first().json;\nreturn [{\n  json: {\n    status: 'error',\n    data: {\n      aerolinea: null,\n      numero_vuelo: null,\n      aeropuerto_salida: null,\n      aeropuerto_llegada: null,\n      fecha_salida: null,\n      hora_salida: null,\n      fecha_llegada: null,\n      hora_llegada: null,\n      codigo_reserva: null,\n      confianza: 0,\n      // Mismo criterio que la Guardia de arriba, aplicado a un fallo del\n      // Worker: nunca se marca 'completo' cuando ni siquiera se pudo\n      // llamar al modelo.\n      estado_validacion: 'conflicto',\n      motivo: 'No se pudo evaluar automaticamente: el Worker fallo.',\n      reason: 'worker_call_failed',\n      detail: (err.error && err.error.message) || err.message || 'Error desconocido al invocar el modelo'\n    },\n    meta: { worker: 'worker_vuelos' }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
        256
      ],
      "id": "3c8e1142-67f8-47b9-bcda-e22db2e4d54e",
      "name": "Contingencia por fallo"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst UMBRAL_CONFIANZA = 0.7;\n\n// Mismo patron tolerante que el resto de los Workers: acepta texto u\n// objeto ya estructurado, y desenvuelve una posible clave extra 'output'.\nlet raw = item.output;\nif (raw && typeof raw === 'object') {\n  raw = raw.output && typeof raw.output === 'object' ? raw.output : raw;\n} else {\n  raw = (raw || '').toString().replace(/```json|```/g, '').trim();\n  try {\n    const parsed = JSON.parse(raw);\n    raw = (parsed.output && typeof parsed.output === 'object') ? parsed.output : parsed;\n  } catch (e) {\n    raw = null;\n  }\n}\n\nconst data = raw;\nconst n = data ? Number(data.confianza) : 0;\nconst confianza = Number.isFinite(n) ? n : 0;\n\n// Guardia - Taxonomia cerrada de estado: sin numero de vuelo o fecha de\n// salida, o con confianza baja, se marca 'conflicto' -- nunca se marca\n// 'completo' sin evidencia solida, porque un vuelo mal cargado es peor\n// que uno pendiente de revisar.\nconst tieneDatosMinimos = data && data.numero_vuelo && data.fecha_salida;\nlet estado_validacion;\nlet motivo;\nif (!data) {\n  estado_validacion = 'conflicto';\n  motivo = 'No se pudo interpretar la respuesta del modelo.';\n} else if (!tieneDatosMinimos || confianza < UMBRAL_CONFIANZA) {\n  estado_validacion = 'conflicto';\n  motivo = data.motivo || 'Extraccion incompleta o de baja confianza, requiere revision manual.';\n} else {\n  estado_validacion = 'completo';\n  motivo = data.motivo || 'Itinerario extraido correctamente.';\n}\n\nreturn [{\n  json: {\n    status: 'success',\n    data: {\n      aerolinea: (data && data.aerolinea) || null,\n      numero_vuelo: (data && data.numero_vuelo) || null,\n      aeropuerto_salida: (data && data.aeropuerto_salida) || null,\n      aeropuerto_llegada: (data && data.aeropuerto_llegada) || null,\n      fecha_salida: (data && data.fecha_salida) || null,\n      hora_salida: (data && data.hora_salida) || null,\n      fecha_llegada: (data && data.fecha_llegada) || null,\n      hora_llegada: (data && data.hora_llegada) || null,\n      codigo_reserva: (data && data.codigo_reserva) || null,\n      confianza,\n      estado_validacion,\n      motivo\n    },\n    meta: { worker: 'worker_vuelos', model: 'gemini-agent' }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
