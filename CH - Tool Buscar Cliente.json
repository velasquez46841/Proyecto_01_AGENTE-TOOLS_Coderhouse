    {
      "parameters": {
        "jsCode": "const base = $('Extraer datos y vinculos').first().json;\nconst cliente = base.cliente;\n\nconst datosPersonales = $('Buscar Datos personales').first().json.fields || null;\nconst pasaporte = $('Buscar Pasaporte').first().json.fields || null;\nconst alojamiento = $('Buscar Alojamiento').first().json.fields || null;\nconst saludYDieta = $('Buscar Salud y Dieta').first().json.fields || null;\nconst intereses = $('Buscar Intereses').first().json.fields || null;\nconst ventas = $('Buscar Ventas').all().filter(i => i.json && i.json.fields).map(i => i.json.fields);\nconst vuelos = $('Buscar Vuelos').all().filter(i => i.json && i.json.fields).map(i => i.json.fields);\n\nconst resultado = {\n  Cliente: cliente,\n  Datos_personales: datosPersonales,\n  Pasaporte: pasaporte,\n  Alojamiento: alojamiento,\n  Salud_y_Dieta: saludYDieta,\n  Intereses: intereses,\n  Ventas: ventas,\n  Vuelos: vuelos\n};\n\nreturn [{ json: { resultado: JSON.stringify(resultado) } }];"
      },
